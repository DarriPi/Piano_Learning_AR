  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Position your keyboard</b>\n\u2022 Find the tall <color=#FF4D99>pink</color>
    post \u2014 that's <b>Middle C</b>. Slide the keyboard so it sits on Middle C
    of your real piano. (The shorter gold posts mark the other C's.)\n\u2022 Line
    up the bright <color=#33FFD9>teal</color> front line with the front edge of your
    keys.\n\u2022 Fine-tune with the controllers:  right stick = move \xB7 left stick
    = rotate / raise-lower \xB7 hold right trigger = faster \xB7 X / Y = narrower
    / wider \xB7 B = reset \xB7 A = done."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
